# 第三方依赖：用 requirements.txt 重建，不入库
.vendor/
venv/
.venv/

# Python 缓存
__pycache__/
*.py[cod]
*.egg-info/

# 工作目录里的构建产物（万一直接在工具目录里跑过）
.jybuild/
work/

# 草稿备份目录：jycore.write() 写回前会把整份草稿拷到 <工作目录>/.tmp/
.tmp/

# 实验/调试用的临时目录：任何一次性尝试、草稿备份、解密产物都放这里
tmp/

# 第三方参考仓库（doctor.py 缺了会自动 clone，不入库）
utils/jy-draftc/

# 本地配置（每台机器的剪映路径不同）
config.json

# AI 会话记忆（WorkBuddy 工作区数据，非工具本体）
.workbuddy/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
